{
  "name": "plan-editor",
  "version": "0.1.0",
  "description": "Click an element, say what you want, watch it change in place. No reload.",
  "type": "module",
  "bin": {
    "plan-editor": "bin/plan-editor.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "bun run build && bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit",
    "test": "bun run scripts/test.ts",
    "start": "bun run bin/plan-editor.js",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "express": "^5.2.1",
    "idiomorph": "^0.7.4",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.0",
    "mermaid": "11.12.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "license": "MIT",
  "private": true,
  "module": "src/cli.ts"
}
